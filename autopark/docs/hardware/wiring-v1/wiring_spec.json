    "ENC": "mt6701",
    "B3": "b3_charger"
  },
  "operating_nets": [
    {
      "id": "BAT_PLUS",
      "endpoints": [
        "BAT.plus",
        "ESC.battery_plus"
      ],
      "voltage": "2S: nominal 7.4V, max 8.4V"
    },
    {
      "id": "BAT_MINUS",
      "endpoints": [
        "BAT.minus",
        "ESC.battery_minus"
      ],
      "voltage": "battery return"
    },
    {
      "id": "GND",
      "endpoints": [
        "ESP.gnd",
        "ESC.gnd",
        "SERVO.gnd",
        "AS.gnd",
        "ENC.gnd"
      ],
      "voltage": "common signal reference; servo power return directly to ESC/BEC, not through ESP32"
    },
    {
      "id": "MOTOR_A",
      "endpoints": [
        "ESC.motor_a",
        "MOTOR.a"
      ],
      "voltage": "switched motor output; NOT logic GND"
    },
    {
      "id": "MOTOR_B",
      "endpoints": [
        "ESC.motor_b",
        "MOTOR.b"
      ],
      "voltage": "switched motor output; NOT logic GND"
    },
    {
      "id": "ESC_CTRL",
      "endpoints": [
        "ESP.esc_pwm",
        "ESC.signal"
      ],
      "gpio": 4,
      "condition": "confirm ESC accepts 3.3V signal and pulse range"
    },
    {
      "id": "SERVO_CTRL",
      "endpoints": [
        "ESP.servo_pwm",
        "SERVO.signal"
      ],
      "gpio": 5,
      "condition": "confirm stock servo signal/pinout"
    },
    {
      "id": "V_SERVO",
      "endpoints": [
        "ESC.bec_plus",
        "SERVO.vplus"
      ],
      "voltage": 6.0,
      "reference_current_a": 3.0,
      "condition": "connect ONLY after confirming the stock servo supports 6V, actual ESC BEC voltage and load current fit; no parallel supply; never to ESP32 rails or GPIO"
    },
    {
      "id": "3V3",
      "endpoints": [
        "ESP.v3v3",
        "AS.vcc",
        "ENC.vcc"
      ],
      "voltage": "3.3V",
      "condition": "breakouts must support 3.3V; verify onboard regulator/pullups and total current"
    },
    {
      "id": "SDA",
      "endpoints": [
        "ESP.sda",
        "AS.sda"
      ],
      "gpio": 6,
      "condition": "pullups only to3.3V"
    },
    {
      "id": "SCL",
      "endpoints": [
        "ESP.scl",
        "AS.scl"
      ],
      "gpio": 7,
      "condition": "pullups only to3.3V"
    },
    {
      "id": "ENC_A",
      "endpoints": [
        "ESP.enc_a",
        "ENC.a"
      ],
      "gpio": 8,
      "condition": "confirm MT6701 module MODE and PPR"
    },
    {
      "id": "ENC_B",
      "endpoints": [
        "ESP.enc_b",
        "ENC.b"
      ],
      "gpio": 9,
      "condition": "confirm MT6701 module MODE and PPR"
    }
