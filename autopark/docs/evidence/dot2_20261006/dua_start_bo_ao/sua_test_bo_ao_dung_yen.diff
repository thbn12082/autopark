+    io.arm()
+    for _ in range(50):                                              # ≈ 0,5 s ở 0,1 m/s, lệnh mới mỗi ≈ 10 ms
+        io.send(0.1, 0.0, enable=True, validity_s=0.15)
+        io.poll()
+    assert io.latest().speed_ref_mps == pytest.approx(0.1)
+    io.stop()
+    io.disarm()
+    io.close()
+    assert board.firmware.speed_ref_mm_s >= 90                       # firmware còn dốc về 0
+    assert 0.1 <= wait_board_at_rest(board) <= 0.3
+    assert board.firmware.speed_ref_mm_s == 0
+    io = fresh_io(board)
+    assert io.latest().speed_ref_mps == 0.0                          # khung đầu của phiên sau: đứng yên
+    io.close()
+    assert wait_board_at_rest(board) < 0.1                           # đã đứng yên: không chờ thêm khung nào
